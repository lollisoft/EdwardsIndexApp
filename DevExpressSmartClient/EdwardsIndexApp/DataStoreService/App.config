<?xml version="1.0" encoding="utf-8" ?>
<configuration>
 
  <configSections>
    <section name="microsoft.identityModel" type="Microsoft.IdentityModel.Configuration.MicrosoftIdentityModelSection, Microsoft.IdentityModel, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"/>
  </configSections>

  <microsoft.identityModel>
    <service name="EdwardsIndexAppDataStoreService.EdwardsIndexAppDataStore" saveBootstrapTokens="true">
      <claimsAuthorizationManager type="EdwardsIndexAppDataStoreService.EdwardsIndexAppDataStoreClaimsAuthorizationManager, EdwardsIndexAppDataStoreService"/>
      <audienceUris>
        <add value="net.tcp://cloud.lollisoft.de:8000/sts/"/>
        <add value="net.tcp://cloud.lollisoft.de:49383/EdwardsIndexAppService"/>
      </audienceUris>
      <issuerNameRegistry type="Microsoft.IdentityModel.Tokens.ConfigurationBasedIssuerNameRegistry, Microsoft.IdentityModel, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35">
        <trustedIssuers>
<!-- 
This is the STS service's own token that may be trusted to. The service
implementation will trust to an STS. The trusted STS token must be exported
from the hosting machine of the STS service - without the private key.

Here you reference the token for the STS service you trust.
-->
          <add thumbprint="6c 38 55 87 4d a9 69 0d 81 da a6 7f db 24 15 58 88 51 45 c8" name="net.tcp://cloud.lollisoft.de:8000/sts/"/>
        </trustedIssuers>
      </issuerNameRegistry>
      <serviceCertificate>
<!--
This token will be configured in the STS Management app per ApprovedAudience entry.
It is used in the certificateReference element of the serviceCertificate node within
the identityModel and is the sercice's own certificate.

To make the STS service work with this certificate, you must also export the public
part of that certificate from the service implementation machine. (At least from one).

TODO: How to automate this installation step?

-->
        <certificateReference
                    x509FindType="FindByThumbprint"
                    findValue="6c 38 55 87 4d a9 69 0d 81 da a6 7f db 24 15 58 88 51 45 c8"
                    storeLocation="LocalMachine"
                    storeName="My" />
      </serviceCertificate>
    </service>
  </microsoft.identityModel>
 
  
<system.diagnostics>
  <sources>
    <source name="System.ServiceModel.MessageLogging" switchValue="Error">
      <listeners>
        <add type="System.Diagnostics.DefaultTraceListener" name="Default"/>
        <add name="ServiceModelMessageLoggingListener"/>
      </listeners>
    </source>
    <source name="System.ServiceModel" switchValue="Error"
        propagateActivity="true">
      <listeners>
        <add type="System.Diagnostics.DefaultTraceListener" name="Default"/>
        <add name="ServiceModelTraceListener"/>
      </listeners>
    </source>
    <source name="EdwardsIndexAppDataStoreService" switchValue="Information">
      <listeners>
        <add name="ServiceModelTextTraceListener"/>
      </listeners>
    </source>
    <source name="EdwardsIndexAppDataStoreService" switchValue="Information">
      <listeners>
        <add name="DBTraceListener"/>
      </listeners>
    </source>
  </sources>
  <sharedListeners>
    <add initializeData="sts_messages.svclog"
        type="System.Diagnostics.XmlWriterTraceListener, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
        name="ServiceModelMessageLoggingListener" traceOutputOptions="Timestamp">
      <filter type="" />
    </add>
    <add initializeData="sts_tracelog.svclog"
        type="System.Diagnostics.XmlWriterTraceListener, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
        name="ServiceModelTraceListener" traceOutputOptions="Timestamp">
      <filter type="" />
    </add>
    <add initializeData="stsAuth.log"
		type="System.Diagnostics.TextWriterTraceListener, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
		name="ServiceModelTextTraceListener" traceOutputOptions="DateTime">
      <filter type="" />
    </add>
    <add name="DBTraceListener" type="Lollisoft.Common.Logging.Trace.DatabaseListener, Lollisoft.Common.Logging"/>
  </sharedListeners>
  <trace autoflush="true" indentsize="4">
    <listeners>
      <add name="EdwardsIndexAppServiceListener" type="System.Diagnostics.TextWriterTraceListener" initializeData="Service.log" />
      <add name="DBTraceListener" type="Lollisoft.Common.Logging.Trace.DatabaseListener, Lollisoft.Common.Logging"/>
      <remove name="Default" />
    </listeners>
  </trace>
</system.diagnostics>

  <appSettings>
    <add key="DataStoreSecurityMode" value="Brokered_Auth"/>
    <add key="DataStoreHost" value="localhost"/>
    <add key="DataStorePort" value="49381"/>
    <add key="IncludeExceptionDetailInFaults" value="false"/>
    <add key="CertLoc" value="LocalComputer"/>
    <add key="CertGroup" value="My"/>
	<!-- Not used in the Brokered_Auth setup -->
    <add key="Fingerprint" value="6c 38 55 87 4d a9 69 0d 81 da a6 7f db 24 15 58 88 51 45 c8"/>
    <add key="LoggingServiceEndpoint" value="LoggingServiceEndpoint"/>

	<!-- Both username and password parameters must not be empty to get accepted and passed -->

	<!-- create an account used for logging -->
    <add key="LoggingServiceUser" value=""/>
	<!-- put your password here -->
    <add key="LoggingServicePass" value=""/>
	<!-- 
	Interval for log shipping. The service will buffer logs for the amount of milliseconds.
	A minimal value of 1000 is enforced to avoid overload by contacting the logging service.
	-->
    <add key="LogInterval" value="5000"/>
	
    <!-- put your application id here -->
    <add key="LogApplicationId" value="0"/>
    <!-- put your environment id here -->
    <add key="LogDeploymentEnvironmentId" value="0"/>
    <!-- put your machine id here -->
    <add key="LogMachineId" value="0"/>
  </appSettings>

  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0"/>
  </startup>

  <system.serviceModel>
    <diagnostics>
      <messageLogging
				logMalformedMessages="true"
				logMessagesAtServiceLevel="false"
				logEntireMessage="false"
				logMessagesAtTransportLevel="false"/>
    </diagnostics>
	
    <client>
      <endpoint name="LoggingServiceEndpoint" address="net.tcp://cloud.lollisoft.de:8000/logging"
				binding="customBinding"
				contract="Lollisoft.DatabaseLogging.ServiceInterfaces.ILoggingService"
				behaviorConfiguration="ServiceBehavior"
				bindingConfiguration="LoggingServiceBinding">
      </endpoint>
    </client>
	
    <services>
      <service name="EdwardsIndexAppDataStoreService.EdwardsIndexAppDataStore" behaviorConfiguration="SampleService">
        <endpoint address="" binding="customBinding" bindingConfiguration="SampleService" contract="DevExpress.Xpo.DB.IDataStoreWarpService"/>

        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://cloud.lollisoft.de:49383/EdwardsIndexAppService"/>
          </baseAddresses>
        </host>
      </service>
    </services>
    <bindings>
      <customBinding>
	  
        <binding name="UsernameBinding">
          <security authenticationMode="SecureConversation"  requireSecurityContextCancellation="true">
            <secureConversationBootstrap authenticationMode="UserNameForSslNegotiated" />
          </security>
          <binaryMessageEncoding/>
          <tcpTransport/>
        </binding>

        <binding name="LoggingServiceBinding">
          <security authenticationMode="SecureConversation">
            <secureConversationBootstrap authenticationMode="IssuedToken">
              <issuedTokenParameters tokenType="http://docs.oasis-open.org/wss/oasis-wss-saml-token-profile-1.1#SAMLV1.1">
                <issuer address="net.tcp://cloud.lollisoft.de:8000/sts" bindingConfiguration="UsernameBinding" binding="customBinding">
                  <!--identity>
                    <dns value="cloud.lollisoft.de"/>
                  </identity-->
                </issuer>
              </issuedTokenParameters>
            </secureConversationBootstrap>
          </security>
          <binaryMessageEncoding>
            <readerQuotas maxDepth="64" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647"/>
          </binaryMessageEncoding>
          <tcpTransport maxReceivedMessageSize="2147483647"/>
        </binding>
	  
        <binding name="SampleService">
          <security authenticationMode="SecureConversation" requireSecurityContextCancellation="true">
            <secureConversationBootstrap authenticationMode="IssuedToken">
              <!-- secureConversationBootstrap UserNameForCertificate -->
              <issuedTokenParameters tokenType="http://docs.oasis-open.org/wss/oasis-wss-saml-token-profile-1.1#SAMLV1.1">

                <claimTypeRequirements>
                  <add claimType="http://schemas.microsoft.com/ws/2005/05/identity/claims/UserName" isOptional="false"/>
                  <add claimType="http://schemas.microsoft.com/ws/2005/05/identity/claims/Role" isOptional="false"/>
                  <add claimType="MyClaimType" isOptional="false"/>
                </claimTypeRequirements>

              </issuedTokenParameters>
            </secureConversationBootstrap>

          </security>
          <binaryMessageEncoding>
            <readerQuotas maxDepth="64" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647"/>
          </binaryMessageEncoding>
		  <!-- 
		  Warning: Think twice about port sharing, but if you can only use one port, it will be possible. Configure Net.Tcp-Portsharing service to startup on demand at least.
		  sc.exe config NetTcpPortSharing start= demand
		  
		  Note: I have encountered a wrong setting how the service logs on. (http://msdn.microsoft.com/en-us/library/ms733925%28v=vs.100%29.aspx)
		  -->
          <tcpTransport maxReceivedMessageSize="2147483647" portSharingEnabled="true"/>
        </binding>
		
        <binding name="PublicServiceBinding">
          <security authenticationMode="SecureConversation">
            <secureConversationBootstrap authenticationMode="AnonymousForSslNegotiated">
              <issuedTokenParameters tokenType="http://docs.oasis-open.org/wss/oasis-wss-saml-token-profile-1.1#SAMLV1.1">
                <issuer address="net.tcp://cloud.lollisoft.de:8000/sts" bindingConfiguration="UsernameBinding" binding="customBinding">
                  <!--identity>
                    <dns value="cloud.lollisoft.de"/>
                  </identity-->
                </issuer>
              </issuedTokenParameters>
            </secureConversationBootstrap>
          </security>
          <binaryMessageEncoding>
            <readerQuotas maxDepth="64" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647"/>
          </binaryMessageEncoding>
          <tcpTransport maxReceivedMessageSize="2147483647"/>
        </binding>
		
      </customBinding>
    </bindings>
    <behaviors>
      <serviceBehaviors>
        <behavior name="SampleService" returnUnknownExceptionsAsFaults="false">
          <serviceAuthorization principalPermissionMode="Custom" serviceAuthorizationManagerType="EdwardsIndexAppDataStoreService.EdwardsIndexAppDataStoreServiceAuthorizationManager, EdwardsIndexAppDataStoreService">

          </serviceAuthorization>
          <serviceCredentials>
            <!--
            http://social.msdn.microsoft.com/Forums/en-US/d5d0f452-f413-46fb-8308-a79a1ef68414/multiple-values-for-audience-uris
            http://msdn.microsoft.com/en-us/library/hh568638%28v=vs.110%29.aspx
            -->
            <issuedTokenAuthentication allowUntrustedRsaIssuers="true" audienceUriMode="Always" revocationMode="NoCheck" certificateValidationMode="None">
              <knownCertificates>
<!-- 
This is the STS service's own token that may be trusted to. The service
implementation will trust to an STS. The trusted STS token must be exported
from the hosting machine of the STS service - without the private key.
The storeLocation, storeName must match the place you chose for the public
certificate you import.

TODO: How to automate this installation step?

Here you define, where the certificate can be found.
-->
                <add storeLocation="LocalMachine" storeName="My" findValue="6c 38 55 87 4d a9 69 0d 81 da a6 7f db 24 15 58 88 51 45 c8" x509FindType="FindByThumbprint"/>
              </knownCertificates>

              <allowedAudienceUris>
                <add allowedAudienceUri="net.tcp://cloud.lollisoft.de:8000/sts"/>
              </allowedAudienceUris>

            </issuedTokenAuthentication>
          </serviceCredentials>
        </behavior>
      </serviceBehaviors>
	  
      <endpointBehaviors>
        <behavior name="ServiceBehavior">
        </behavior>
      </endpointBehaviors>
	  
    </behaviors>
  </system.serviceModel>
  
</configuration>
