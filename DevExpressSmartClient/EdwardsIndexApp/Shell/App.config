<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<section name="securityConfiguration" type="Microsoft.Practices.EnterpriseLibrary.Security.Configuration.SecuritySettings, Microsoft.Practices.EnterpriseLibrary.Security, Version=3.1.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" />
		<section name="shellitems" type="EdwardsIndexAppShell.ShellItemsSection, EdwardsIndexAppShell" />
		<section name="CompositeUI" type="Microsoft.Practices.CompositeUI.Configuration.SettingsSection, Microsoft.Practices.CompositeUI" allowExeDefinition="MachineToLocalUser" />
	</configSections>
	<securityConfiguration defaultAuthorizationInstance="" defaultSecurityCacheInstance="">
		<authorizationProviders>
		<add type="EdwardsIndexAppSecurity.Authorization.EdwardsIndexAppAuthorization, EdwardsIndexAppSecurity, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null"
        name="Custom Authorization Provider" />
		</authorizationProviders>
	</securityConfiguration>
	<CompositeUI>
		<!--<visualizer>
			<add type="SampleVisualizations.WorkItemVisualization, SampleVisualizations" />
		</visualizer>-->
		<services>
			<add serviceType="Microsoft.Practices.CompositeUI.Services.IStatePersistenceService, Microsoft.Practices.CompositeUI" instanceType="Microsoft.Practices.CompositeUI.Services.IsolatedStorageStatePersistenceService, Microsoft.Practices.CompositeUI" />
		</services>
	</CompositeUI>
	<shellitems>
		<menuitems>
			<!--<add id="1" site="MainMenu" label="&amp;Help" register="true" registrationsite="Help" />-->
			<add id="2" site="ToolBar;Help;RibbonPageHeader;RibbonAppMenuBottomPane=SimpleButton" label="&amp;About" glyph="About16" largeglyph="About32" commandname="HelpAboutCommand" key="F1" />
			<add id="3" site="Page_Home_Group_File;RibbonAppMenuBottomPane=SimpleButton" label="E&amp;xit" glyph="Exit16" largeglyph="Exit32" commandname="ExitCommand" key="Alt, F4" />
		</menuitems>
	</shellitems>

    <system.web>
        <httpModules>
            <add name="ASPxHttpHandlerModule" type="DevExpress.Web.ASPxClasses.ASPxHttpHandlerModule, DevExpress.Web.v11.1, Version=11.1.7.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" />
        </httpModules>
    </system.web>

    <system.webServer>
        <modules>
            <add name="ASPxHttpHandlerModule" type="DevExpress.Web.ASPxClasses.ASPxHttpHandlerModule, DevExpress.Web.v11.1, Version=11.1.7.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" />
        </modules>
    </system.webServer>

	<appSettings>

      <add key="DataStoreSecurityMode" value="Brokered_Auth"/>
					
		
      <!-- To enable performance measurements, set the value to true. -->
      <!-- Inspect ShellCommon.MessagePerformanceMonitor class for collected values (PerformanceMeasures). -->
      <!-- TODO: Implement grid view to display and export the values. -->
      <add key="EnablePerformanceMeasurement" value="false"/>

      <add key="DataStoreHost" value="cloud.lollisoft.de"/>
      <add key="DataStorePort" value="49381"/>
      <!--add key="X509CertificateValidationMode" value="None"/-->
      <!--add key="DnsIdentity" value="cloud.lollisoft.de"/-->

      <add key="LogApplicationId" value="1"/>
      <add key="LogDeploymentEnvironmentId" value="1"/>
      <add key="LogMachineId" value="1"/>

  </appSettings>


  <system.serviceModel>
    <diagnostics>
      <messageLogging
				logMalformedMessages="false"
				logMessagesAtServiceLevel="false"
				logEntireMessage="false"
				logMessagesAtTransportLevel="false"/>
    </diagnostics>

    <client>
      <endpoint name="EdwardsIndexAppEndpoint" address="net.tcp://cloud.lollisoft.de:49383/EdwardsIndexAppService"
				binding="customBinding"
				contract="DevExpress.Xpo.DB.IDataStoreWarpService"
				behaviorConfiguration="ServiceBehavior"
				bindingConfiguration="ServiceBinding">
      </endpoint>

      <endpoint name="UserProfileEndpoint" address="net.tcp://cloud.lollisoft.de:8000/userprofile"
				binding="customBinding"
				contract="StsServiceInterfaces.IUserProfileService"
				behaviorConfiguration="ServiceBehavior"
				bindingConfiguration="PublicServiceBinding">
      </endpoint>

      <endpoint name="LoggingServiceEndpoint" address="net.tcp://cloud.lollisoft.de:8000/logging"
				binding="customBinding"
				contract="Lollisoft.DatabaseLogging.ServiceInterfaces.ILoggingService"
				behaviorConfiguration="ServiceBehavior"
				bindingConfiguration="PublicServiceBinding">
      </endpoint>
	  
	  
	  
    </client>

    <bindings>
      <customBinding>

        <binding name="UsernameBinding">
          <security authenticationMode="SecureConversation"  requireSecurityContextCancellation="true">
            <secureConversationBootstrap authenticationMode="UserNameForSslNegotiated" />
          </security>
          <binaryMessageEncoding/>
          <tcpTransport/>
        </binding>

        <binding name="MutalCertificateBinding">
          <security authenticationMode="SecureConversation" requireSecurityContextCancellation="true">
            <secureConversationBootstrap
              authenticationMode="MutualCertificate"/>
          </security>
          <binaryMessageEncoding/>
          <tcpTransport />
        </binding>

        <binding name="ServiceBinding">
          <security authenticationMode="SecureConversation">
            <secureConversationBootstrap authenticationMode="IssuedToken">
              <issuedTokenParameters tokenType="http://docs.oasis-open.org/wss/oasis-wss-saml-token-profile-1.1#SAMLV1.1">
                <issuer address="net.tcp://cloud.lollisoft.de:8000/sts" bindingConfiguration="UsernameBinding" binding="customBinding">
                  <!--identity>
                    <dns value="cloud.lollisoft.de"/>
                  </identity-->
                </issuer>
              </issuedTokenParameters>
            </secureConversationBootstrap>
          </security>
          <binaryMessageEncoding>
            <readerQuotas maxDepth="64" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647"/>
          </binaryMessageEncoding>
          <tcpTransport maxReceivedMessageSize="2147483647"/>
        </binding>
		
        <binding name="PublicServiceBinding">
          <security authenticationMode="SecureConversation">
            <secureConversationBootstrap authenticationMode="AnonymousForSslNegotiated">
              <issuedTokenParameters tokenType="http://docs.oasis-open.org/wss/oasis-wss-saml-token-profile-1.1#SAMLV1.1">
                <issuer address="net.tcp://cloud.lollisoft.de:8000/sts" bindingConfiguration="UsernameBinding" binding="customBinding">
                  <!--identity>
                    <dns value="cloud.lollisoft.de"/>
                  </identity-->
                </issuer>
              </issuedTokenParameters>
            </secureConversationBootstrap>
          </security>
          <binaryMessageEncoding>
            <readerQuotas maxDepth="64" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647"/>
          </binaryMessageEncoding>
          <tcpTransport maxReceivedMessageSize="2147483647"/>
        </binding>
		
      </customBinding>
    </bindings>

    <behaviors>
      <endpointBehaviors>
        <behavior name="ServiceBehavior">
          <!--clientCredentials>
            <clientCertificate findValue="6c 38 55 87 4d a9 69 0d 81 da a6 7f db 24 15 58 88 51 45 c8" storeLocation="LocalMachine" storeName="My" x509FindType="FindByThumbprint"/>
            <serviceCertificate>
              <defaultCertificate findValue="6c 38 55 87 4d a9 69 0d 81 da a6 7f db 24 15 58 88 51 45 c8" storeLocation="LocalMachine" storeName="My" x509FindType="FindByThumbprint"/>
              <authentication revocationMode="NoCheck" certificateValidationMode="None"></authentication>
            </serviceCertificate>
          </clientCredentials-->
        </behavior>
      </endpointBehaviors>
    </behaviors>
  </system.serviceModel>
					

<system.diagnostics>
    <sources>
      <source name="EdwardsIndexAppShell" switchValue="Information">
        <listeners>
          <add name="DBTraceListener"/>
        </listeners>
      </source>
      <source name="EdwardsIndexAppModule.Services" switchValue="Information">
        <listeners>
          <add name="DBTraceListener"/>
        </listeners>
      </source>
    </sources>
    <trace autoflush="true" indentsize="4">
      <listeners>
        <add name="DBTraceListener" type="Lollisoft.Common.Logging.Trace.DatabaseListener, Lollisoft.Common.Logging"/>
        <remove name="Default" />
      </listeners>
    </trace>
  </system.diagnostics>

	
</configuration>
