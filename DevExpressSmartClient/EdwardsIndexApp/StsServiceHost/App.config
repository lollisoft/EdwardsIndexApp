<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <section name="StsService" type="StsService.STSConfiguration, StsService"/>
  </configSections>

<!-- 
The STS service will use the STSCertFingerPrint variable at all places.
No service, other than STS servive and STS management service is configured.
And the STS management service is located near the STS service and thus uses
the same certificate. (At least with my understanding)
-->
  
  <system.diagnostics>
    <sources>
      <source name="System.ServiceModel.MessageLogging" switchValue="Warning, ActivityTracing">
        <listeners>
          <add type="System.Diagnostics.DefaultTraceListener" name="Default"/>
          <add name="ServiceModelMessageLoggingListener"/>
        </listeners>
      </source>
      <source name="System.ServiceModel" switchValue="Error,ActivityTracing"
					propagateActivity="true">
        <listeners>
          <add type="System.Diagnostics.DefaultTraceListener" name="Default"/>
          <add name="ServiceModelTraceListener"/>
        </listeners>
      </source>
      <source name="StsService" switchValue="Information">
        <listeners>
          <add name="ServiceModelTextTraceListener"/>
        </listeners>
      </source>
    </sources>
    <sharedListeners>
      <add initializeData="sts_messages.svclog"
					type="System.Diagnostics.XmlWriterTraceListener, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
					name="ServiceModelMessageLoggingListener" traceOutputOptions="Timestamp">
        <filter type="" />
      </add>
      <add initializeData="sts_tracelog.svclog"
					type="System.Diagnostics.XmlWriterTraceListener, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
					name="ServiceModelTraceListener" traceOutputOptions="Timestamp">
        <filter type="" />
      </add>
      <add initializeData="stsAuth.log"
					type="System.Diagnostics.TextWriterTraceListener, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
					name="ServiceModelTextTraceListener" traceOutputOptions="DateTime">
        <filter type="" />
      </add>
    </sharedListeners>
    <trace autoflush="true" />
  </system.diagnostics>

  <system.serviceModel>
    <diagnostics>
      <messageLogging
				logMalformedMessages="true"
				logMessagesAtServiceLevel="true"
				logEntireMessage="true"
				logMessagesAtTransportLevel="true"/>
    </diagnostics>

    <!--
http://weblogs.asp.net/cibrax/archive/2008/04/21/federation-over-tcp-with-wcf.aspx
https://github.com/thinktecture
http://stackoverflow.com/questions/6111754/possible-to-have-wcf-sts-with-username-password-and-client-certificate
http://msdn.microsoft.com/en-us/library/dd833059%28v=vs.95%29.aspx
http://cibrax.me/
http://msdn.microsoft.com/en-us/library/aa347793%28v=vs.110%29.aspx
http://www.hanselman.com/blog/BreakingAllTheRulesWithWCF.aspx
http://msdn.microsoft.com/en-us/library/system.servicemodel.configuration.authenticationmode%28v=vs.110%29.aspx
http://msdn.microsoft.com/en-us/library/aa749859%28v=vs.110%29.aspx
http://msdn.microsoft.com/en-us/library/aa355062%28v=vs.100%29.aspx
http://social.msdn.microsoft.com/Forums/en-US/eacae126-7539-4de4-81fe-4a1f923a3482/federation-over-tcp-part-2?forum=wcf
http://blog.tonysneed.com/2012/06/18/building-scalable-and-secure-wcf-services/
http://stackoverflow.com/questions/12828295/wcf-custom-username-authentication-using-http
http://social.msdn.microsoft.com/Forums/vstudio/en-US/dcf8dcb1-d9d8-44c0-9415-d985b2d19300/help-me-programmatically-create-a-custom-binding?forum=wcf
http://stackoverflow.com/questions/10978022/wcf-service-secured-by-sts-issuedtoken-configuration-issue
http://litwarehr.codeplex.com/SourceControl/latest#litware%20-%20May%202008/solution/LitwareHR/LitwareHR.Authentication.SvcHost/Web.config
http://social.msdn.microsoft.com/Forums/vstudio/en-US/1b99c331-9d38-447a-bb3b-64d7d5f04190/sts-with-custom-usernamepassword-validator-and-windows-integrated-authentication?forum=wcf
http://msdn.microsoft.com/en-us/library/aa354513.aspx
http://social.msdn.microsoft.com/Forums/vstudio/en-US/47cc69d3-c124-453f-a82c-746c95e3e526/how-to-store-soap-message-header-username-and-password-for-later-authentication-in-the-service?forum=wcf
http://stackoverflow.com/questions/3354361/wcf-customusernamepasswordvalidatortype
http://stackoverflow.com/questions/10144348/configuring-wcf-client-gives-the-error-the-message-could-not-be-processed-this

-->

    <services>
      <service behaviorConfiguration="PublicSampleService"
               name="StsService.UserProfileService">

        <!-- Mutual X509 Endpoint -->

        <endpoint
					binding="customBinding"
					address=""
					bindingConfiguration="PublicSampleService"
					contract="StsServiceInterfaces.IUserProfileService">
        </endpoint>

        <host>
          <baseAddresses>
            <add baseAddress ="net.tcp://cloud.lollisoft.de:8000/userprofile" />
          </baseAddresses>
        </host>
      </service>
      <service behaviorConfiguration="ServiceBehaviorWithUserName"
							 name="StsService.SecurityTokenService">
        <!-- Mutual X509 Endpoint -->

        <endpoint
					binding="customBinding"
					address=""
					bindingConfiguration="UsernameBinding"
					contract="StsService.ISecurityTokenService">
        </endpoint>

        <host>
          <baseAddresses>
            <add baseAddress ="net.tcp://cloud.lollisoft.de:8000/sts/" />
          </baseAddresses>
        </host>
      </service>
    </services>

    <bindings>
      <customBinding>
        <binding name="PublicSampleService">
          <security authenticationMode="SecureConversation" requireSecurityContextCancellation="true">
            <secureConversationBootstrap authenticationMode="AnonymousForSslNegotiated">
              <!-- secureConversationBootstrap UserNameForCertificate -->
              <issuedTokenParameters tokenType="http://docs.oasis-open.org/wss/oasis-wss-saml-token-profile-1.1#SAMLV1.1">

                <claimTypeRequirements>
                  <add claimType="http://schemas.microsoft.com/ws/2005/05/identity/claims/UserName" isOptional="false"/>
                  <add claimType="http://schemas.microsoft.com/ws/2005/05/identity/claims/Role" isOptional="false"/>
                  <add claimType="MyClaimType" isOptional="false"/>
                </claimTypeRequirements>

              </issuedTokenParameters>
            </secureConversationBootstrap>

          </security>
          <binaryMessageEncoding>
            <readerQuotas maxDepth="64" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647"/>
          </binaryMessageEncoding>
		  <!-- 
		  Warning: Think twice about port sharing, but if you can only use one port, it will be possible. Configure Net.Tcp-Portsharing service to startup on demand at least.
		  sc.exe config NetTcpPortSharing start= demand
		  
		  Note: I have encountered a wrong setting how the service logs on. (http://msdn.microsoft.com/en-us/library/ms733925%28v=vs.100%29.aspx)
		  -->
          <tcpTransport maxReceivedMessageSize="2147483647" portSharingEnabled="true"/>
        </binding>
        <binding name="SampleService">
          <security authenticationMode="SecureConversation" requireSecurityContextCancellation="true">
            <secureConversationBootstrap authenticationMode="IssuedToken">
              <!-- secureConversationBootstrap UserNameForCertificate -->
              <issuedTokenParameters tokenType="http://docs.oasis-open.org/wss/oasis-wss-saml-token-profile-1.1#SAMLV1.1">

                <claimTypeRequirements>
                  <add claimType="http://schemas.microsoft.com/ws/2005/05/identity/claims/UserName" isOptional="false"/>
                  <add claimType="http://schemas.microsoft.com/ws/2005/05/identity/claims/Role" isOptional="false"/>
                  <add claimType="MyClaimType" isOptional="false"/>
                </claimTypeRequirements>

              </issuedTokenParameters>
            </secureConversationBootstrap>

          </security>
          <binaryMessageEncoding>
            <readerQuotas maxDepth="64" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647"/>
          </binaryMessageEncoding>
		  <!-- 
		  Warning: Think twice about port sharing, but if you can only use one port, it will be possible. Configure Net.Tcp-Portsharing service to startup on demand at least.
		  sc.exe config NetTcpPortSharing start= demand
		  
		  Note: I have encountered a wrong setting how the service logs on. (http://msdn.microsoft.com/en-us/library/ms733925%28v=vs.100%29.aspx)
		  -->
          <tcpTransport maxReceivedMessageSize="2147483647" portSharingEnabled="true"/>
        </binding>
        <binding name="UsernameBinding">
          <!-- TransactionFlow, ReliableSession, Security, CompositeDuplex, OneWay, StreamSecurity, MessageEncoding, Transport. -->
          <security authenticationMode="SecureConversation" requireSecurityContextCancellation="true">
            <secureConversationBootstrap
							authenticationMode="UserNameForSslNegotiated"/>
          </security>
          <binaryMessageEncoding/>
          <tcpTransport maxReceivedMessageSize="2147483647" portSharingEnabled="true"/>
        </binding>

        <binding name="MutualCertificateBinding">
          <security authenticationMode="SecureConversation" requireSecurityContextCancellation="true">
            <secureConversationBootstrap
							authenticationMode="MutualCertificate"/>
          </security>
          <binaryMessageEncoding/>
          <tcpTransport />
        </binding>
      </customBinding>
    </bindings>

    <!--For debugging purposes set the includeExceptionDetailInFaults attribute to true-->
    <behaviors >
      <serviceBehaviors>
        <behavior name="PublicSampleService" returnUnknownExceptionsAsFaults="false">
          <serviceCredentials>
            <serviceCertificate findValue="6c 38 55 87 4d a9 69 0d 81 da a6 7f db 24 15 58 88 51 45 c8" storeLocation="LocalMachine" storeName="My" x509FindType="FindByThumbprint"/>
            <!--
            http://social.msdn.microsoft.com/Forums/en-US/d5d0f452-f413-46fb-8308-a79a1ef68414/multiple-values-for-audience-uris
            http://msdn.microsoft.com/en-us/library/hh568638%28v=vs.110%29.aspx
            -->
            <issuedTokenAuthentication allowUntrustedRsaIssuers="true" audienceUriMode="Always" revocationMode="NoCheck" certificateValidationMode="None">
              <knownCertificates>
                <add storeLocation="LocalMachine" storeName="My" findValue="6c 38 55 87 4d a9 69 0d 81 da a6 7f db 24 15 58 88 51 45 c8" x509FindType="FindByThumbprint"/>
              </knownCertificates>

              <allowedAudienceUris>
                <add allowedAudienceUri="net.tcp://cloud.lollisoft.de:8000/sts/"/>
              </allowedAudienceUris>

            </issuedTokenAuthentication>
          </serviceCredentials>
        </behavior>
        <behavior name="SampleService" returnUnknownExceptionsAsFaults="false">
          <serviceAuthorization principalPermissionMode="Custom" serviceAuthorizationManagerType="StsService.StsServiceAuthorizationManager, StsService">

          </serviceAuthorization>
          <serviceCredentials>
            <!--
            http://social.msdn.microsoft.com/Forums/en-US/d5d0f452-f413-46fb-8308-a79a1ef68414/multiple-values-for-audience-uris
            http://msdn.microsoft.com/en-us/library/hh568638%28v=vs.110%29.aspx
            -->
            <issuedTokenAuthentication allowUntrustedRsaIssuers="true" audienceUriMode="Always" revocationMode="NoCheck" certificateValidationMode="None">
              <knownCertificates>
                <add storeLocation="LocalMachine" storeName="My" findValue="6c 38 55 87 4d a9 69 0d 81 da a6 7f db 24 15 58 88 51 45 c8" x509FindType="FindByThumbprint"/>
              </knownCertificates>

              <allowedAudienceUris>
                <add allowedAudienceUri="net.tcp://cloud.lollisoft.de:8000/sts/"/>
              </allowedAudienceUris>

            </issuedTokenAuthentication>
          </serviceCredentials>
        </behavior>
        <behavior name="ServiceBehaviorWithUserName">
          <serviceCredentials>
            <serviceCertificate findValue="6c 38 55 87 4d a9 69 0d 81 da a6 7f db 24 15 58 88 51 45 c8" storeLocation="LocalMachine" storeName="My" x509FindType="FindByThumbprint"/>

            <userNameAuthentication userNamePasswordValidationMode="Custom" customUserNamePasswordValidatorType="StsService.STSUserNameValidator, StsService"/>

            <!-- Only for Mutual Certificate -->
            <clientCertificate>
              <authentication revocationMode="NoCheck"/>
            </clientCertificate>

          </serviceCredentials>

          <!--<serviceAuthorization principalPermissionMode="Custom" >
            <authorizationPolicies>
              <add policyType="Samples.Security.STS.STSAuthorizationPolicy, Samples.Security.STS"/>
            </authorizationPolicies>
          </serviceAuthorization>-->

          <serviceDebug includeExceptionDetailInFaults="true"/>
        </behavior>

        <behavior name="ServiceBehavior">
          <serviceCredentials>
            <serviceCertificate findValue="6c 38 55 87 4d a9 69 0d 81 da a6 7f db 24 15 58 88 51 45 c8" storeLocation="LocalMachine" storeName="My" x509FindType="FindByThumbprint"/>

            <!-- Only for Mutual Certificate -->
            <clientCertificate>
              <authentication revocationMode="NoCheck"/>
            </clientCertificate>

          </serviceCredentials>

          <serviceDebug includeExceptionDetailInFaults="true"/>
        </behavior>
      </serviceBehaviors>
    </behaviors>

  </system.serviceModel>


  <StsService>
    <samlTokenIssuer ttlInSeconds="300">
      <!-- the config for the saml token issuer, this is the only config we use. This token is used to sign the SAML token -->
      <serviceTokens>
        <!-- SAML Authority certificate -->
        <add uri="http://schemas.xmlsoap.org/ws/2005/02/trust/RST/Issue" storeLocation="LocalMachine" storeName="My" findValue="6c 38 55 87 4d a9 69 0d 81 da a6 7f db 24 15 58 88 51 45 c8" findType="FindByThumbprint"/>
        <!-- StsManagement service -->
        <add uri="net.tcp://cloud.lollisoft.de:49383/StsManagementService" storeLocation="LocalMachine" storeName="My" findValue="6c 38 55 87 4d a9 69 0d 81 da a6 7f db 24 15 58 88 51 45 c8" findType="FindByThumbprint"/>	
      </serviceTokens>
    </samlTokenIssuer>
  </StsService>

  <appSettings>
    <!-- TODO: Set your email server values -->
    <add key="EMailAddress" value="lothar.behrens@lollisoft.de"/>
    <add key="EMailServer" value="jedi.behrens.de"/>
    <add key="EMailUser" value="lothar"/>
    <add key="EMailPass" value=""/>
  </appSettings>
 
  
</configuration>
